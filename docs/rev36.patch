+def baca_env():
+    """Isi .env sebagai dict (tanpa memasukkannya ke environment proses panel)."""
+    try:
+        from dotenv import dotenv_values
+        return {k: (v or "") for k, v in dotenv_values(ROOT / ".env").items()}
+    except Exception:
+        return {}
