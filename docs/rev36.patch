+def _ambil(d, kunci):
+    for k in kunci.split("."):
+        if not isinstance(d, dict) or k not in d:
+            return None
+        d = d[k]
+    return d
+
+
+def _pasang(d, kunci, nilai):
+    ks = kunci.split(".")
+    for k in ks[:-1]:
+        d = d.setdefault(k, {})
+    d[ks[-1]] = nilai
